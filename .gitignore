node_modules

# סודות — לא נכנס לגיט
.env
.env.local

# תמונות שהועלו דרך האדמין — תוכן של הרצה, לא של הקוד.
# uploads/* ולא uploads/, כדי שהתיקייה עצמה לא תוחרג ו-.gitkeep
# יוכל לחזור פנימה. בלי זה גיט לא נכנס לתיקייה בכלל.
uploads/*
!uploads/.gitkeep

# מניפסט נתוני הדמו — מקומי, לא נכנס לגיט
scripts/.seed-demo-manifest.json

# פלט הבילד של הקליינט — נוצר מחדש בכל build, לא נכנס לגיט
client/build/

# רשימת המוצרים לצילום — פלט של npm run products:list, נוצר מחדש בכל הרצה
design-assets/product-list.csv
design-assets/product-list.html

# גיבויי image_url מלפני --apply — מקומיים, לא נכנסים לגיט
design-assets/image-backup-*.json

# צילומי המוצרים: הגלם מהטלפון והתוצרים המעובדים. התיקיות עצמן נשמרות
# (.gitkeep) כדי שהסקריפט ימצא לאן לכתוב, התוכן לא.
photos/raw/*
!photos/raw/.gitkeep
photos/processed/
photos/preview.html

# רשימות וגיבויים של ספירת המלאי שאחרי הצילום — מקומיים, לא נכנסים לגיט
design-assets/to-hide-*.csv
design-assets/hide-backup-*.json

# גיליון המוצרים החדשים והגיבוי של הייבוא — מקומיים, לא נכנסים לגיט
design-assets/new-products.xlsx
design-assets/import-backup-*.json
