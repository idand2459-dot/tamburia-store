node_modules

# סודות — לא נכנס לגיט. רק .env.example (placeholders בלבד) נמצא במעקב,
# ו-test/unit-repo-hygiene.js נכשל אם .env נכנס בטעות.
.env
.env.local
.env.*.local

# קבצי מערכת, עורכים וכלים מקומיים
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/

# לוגים ודוחות כיסוי
*.log
npm-debug.log*
coverage/

# תמונות שהועלו דרך האדמין — תוכן של הרצה, לא של הקוד.
# uploads/* ולא uploads/, כדי שהתיקייה עצמה לא תוחרג ו-.gitkeep
# יוכל לחזור פנימה. בלי זה גיט לא נכנס לתיקייה בכלל.
uploads/*
!uploads/.gitkeep

# מניפסט נתוני הדמו — מקומי, לא נכנס לגיט
scripts/.seed-demo-manifest.json

# פלט הבילד של הקליינט — נוצר מחדש בכל build, לא נכנס לגיט
client/build/

# רשימת המוצרים לצילום — פלט של npm run products:list, נוצר מחדש בכל הרצה
design-assets/product-list.csv
design-assets/product-list.html

# גיבויי image_url מלפני --apply — מקומיים, לא נכנסים לגיט
design-assets/image-backup-*.json

# צילומי המוצרים: הגלם מהטלפון והתוצרים המעובדים. התיקיות עצמן נשמרות
# (.gitkeep) כדי שהסקריפט ימצא לאן לכתוב, התוכן לא.
photos/raw/*
!photos/raw/.gitkeep
photos/processed/
photos/preview.html

# רשימות וגיבויים של ספירת המלאי שאחרי הצילום — מקומיים, לא נכנסים לגיט
design-assets/to-hide-*.csv
design-assets/hide-backup-*.json

# גיליון המוצרים החדשים והגיבוי של הייבוא — מקומיים, לא נכנסים לגיט
design-assets/new-products.xlsx
design-assets/import-backup-*.json

# גיבוי המחירים מלפני החזרת המחירים העשרוניים מה-CSV — מקומי, לא נכנס לגיט
design-assets/price-backup-*.json

# גיבויי ההשלמה לריבוע של תמונות שכבר הועלו (הסקריפט החד-פעמי שרץ
# ב-2026-10-01 ונמחק) — עדיין יושבים מקומית, ולכן נשארים מוחרגים
design-assets/square-backup-*/

# עיבוד מחדש של התמונות שכבר הועלו (images:products --from-uploads) — מקומי, לא נכנס לגיט
photos/processed-uploads/
photos/preview-uploads.html
design-assets/reprocess-backup-*.json

# הצילומים המקוריים מההעלאות, ברזולוציה מלאה — לא מוגשים ולא נכנסים לגיט
uploads-originals/
