# CRA dev server only (npm run dev:client). The API server owns 3000, and CRA
# defaults to 3000 too; this moves the dev server to 3001, on every OS.
# Proxied API calls still go to 3000 ("proxy" in package.json). No secrets here:
# this file is committed, and test/unit-repo-hygiene.js allows only it.
PORT=3001
