# העתק לקובץ בשם .env ומלא ערכים אמיתיים.
# הקובץ הזה כן נכנס לגיט — placeholders בלבד, אף פעם לא סוד.
# (test/unit-repo-hygiene.js נכשל אם משתנה סודי כאן אינו ריק.)

# ── שרת ──────────────────────────────────────────────
# Port the server listens on: 1 to 65535. Default 3000.
PORT=3000
# development, test or production; any other value stops the server. Not set means development.
# A real deployment must set NODE_ENV=production itself: production turns on the Secure cookie,
# HSTS, the strict startup checks below and the one-proxy default of TRUST_PROXY_HOPS.
# As a safety net only, a server with NODE_ENV not set and a DB_HOST that is not on this machine
# refuses to start; that check is not a substitute for setting production.
NODE_ENV=development

# ── PostgreSQL ───────────────────────────────────────
DB_HOST=localhost
# 1 to 65535. Default 5432.
DB_PORT=5432
DB_NAME=tamburia
DB_USER=postgres
DB_PASSWORD=
# רישום כל שאילתה ללוג. ברירת מחדל: פעיל מחוץ לייצור, כבוי בייצור.
DB_LOG_QUERIES=

# ── מייל (Gmail app password) ────────────────────────
# false = לא שולח מיילים באמת, רק רושם ללוג. אז MAIL_USER / MAIL_PASS
# אינם נדרשים — כך שכפול חדש עולה בלי חשבון Gmail. true = שניהם חובה.
MAIL_ENABLED=false
MAIL_USER=
MAIL_PASS=
# לאן נשלחת התראת הזמנה חדשה. ריק = ל-MAIL_USER.
MAIL_TO=

# The admin link in the new-order email. In production it must be set, and be an https URL
# (for example https://example.com/admin); the http://localhost default is for development only.
ADMIN_URL=http://localhost:3000/admin

# ── הזמנות ───────────────────────────────────────────
# דמי משלוח בשקלים. השרת מחשב את הסכום לפיו; הקליינט מציג אותו מתוך
# DELIVERY_FEE ב-client/src/js/utils/delivery.js, ושניהם חייבים להתאים
# (test/unit-config.js בודק את ברירת המחדל; דריסה בסביבת הייצור אינה נבדקת).
DELIVERY_FEE=20

# ── הגשת הקליינט ─────────────────────────────────────
# false = השרת מגיש API בלבד, בלי אפליקציית ה-React.
SERVE_CLIENT=true
CLIENT_BUILD_DIR=client/build

# ── אימות אדמין ──────────────────────────────────────
# הסיסמה לכניסה ל-/admin. נבדקת בשרת בלבד. בייצור לפחות 12 תווים,
# אחרת השרת מסרב לעלות.
ADMIN_PASSWORD=
# Key that signs the admin session tokens. Required in production, at least 32 characters, or the
# server refuses to start. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Not set outside production: a random one is made on every start, so logins do not survive a restart.
SESSION_SECRET=
# How long an admin login lasts, in hours: 1 to 168. There is no server-side logout of a token,
# so a stolen one stays valid until it expires.
SESSION_TTL_HOURS=12
# Login limit: how many attempts per client address, in a window of how many milliseconds.
# The window is 1 to 86400000 (24 hours).
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MS=900000

# ── Rate limits on public writes ──────────────────────
# Per client address, counted in the memory of this one process (a restart resets them, and
# several instances would not share them). Every request counts, a retry of the same order
# included. Over the limit the answer is 429 with Retry-After. A window is 1 to 86400000 ms.
# Orders: 10 per 15 minutes by default.
ORDER_RATE_MAX=10
ORDER_RATE_WINDOW_MS=900000
# Reviews: 5 per hour by default.
REVIEW_RATE_MAX=5
REVIEW_RATE_WINDOW_MS=3600000
# How many proxies stand between the internet and this server: 0 to 5. It decides which address
# the limits above count, so it has to match the real hosting. Not set means 1 in production and
# 0 elsewhere. Check it on the deployed site (see docs/security.md).
TRUST_PROXY_HOPS=

# ── אבטחה ────────────────────────────────────────────
# CSP כבוי כברירת מחדל — ראה את ההערה ב-middleware/securityHeaders.js.
CSP_ENABLED=false
# HSTS נשלח רק כש-NODE_ENV=production. אל תדליק בלי HTTPS אמיתי.
HSTS_ENABLED=true
# Other origins allowed to call the API, separated by commas. Empty means the same origin only
# (in development everything is open anyway). Each one must be exactly what a browser sends:
# scheme://host[:port] in lower case, with no path, no trailing slash, no * and no default port
# (https://example.com, not https://example.com/ or https://example.com:443). Checked on start.
CORS_ORIGINS=

# ── כלים ─────────────────────────────────────────────
# Required by npm test and npm run a11y: a separate local database, made with createdb.
# Add a line of the form postgresql://<user>:<password>@localhost:5432/<database name>.
# It must be local and different from the development database (DB_*); without it, or
# if it is malformed, remote or the development database, they refuse to run.
# It carries a password: put the real value only in .env, never in this file.
TEST_DATABASE_URL=
# הנתיב ל-Chrome של npm run a11y, כשאינו במקום הרגיל.
CHROME_PATH=
