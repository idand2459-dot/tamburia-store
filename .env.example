# העתק לקובץ בשם .env ומלא ערכים אמיתיים.
# הקובץ הזה כן נכנס לגיט — אל תשים בו סודות.

# ── שרת ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── PostgreSQL ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tamburia
DB_USER=postgres
DB_PASSWORD=

# ── מייל (Gmail app password) ────────────────────────
MAIL_USER=
MAIL_PASS=
MAIL_TO=
# false = לא שולח מיילים באמת, רק רושם ללוג. שימושי בפיתוח.
MAIL_ENABLED=true

ADMIN_URL=http://localhost:3001/admin

# ── הזמנות ───────────────────────────────────────────
# דמי משלוח בשקלים. חייב להתאים למה שמוצג בקליינט (App.js).
DELIVERY_FEE=20

# ── הגשת הקליינט ─────────────────────────────────────
# false = השרת מגיש API בלבד, בלי אפליקציית ה-React.
SERVE_CLIENT=true
CLIENT_BUILD_DIR=client/build

# ── אימות אדמין ──────────────────────────────────────
# הסיסמה לכניסה ל-/admin. נבדקת בשרת בלבד.
ADMIN_PASSWORD=
# סוד חתימת האסימונים. חובה בייצור. ייצור ערך:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# תוקף ההתחברות בשעות.
SESSION_TTL_HOURS=12

# ── אבטחה ────────────────────────────────────────────
# CSP כבוי כברירת מחדל — ראה את ההערה ב-middleware/securityHeaders.js.
CSP_ENABLED=false
# HSTS נשלח רק כש-NODE_ENV=production. אל תדליק בלי HTTPS אמיתי.
HSTS_ENABLED=true
# מקורות חיצוניים שמותר להם לפנות ל-API, מופרדים בפסיק.
# ריק = מאותו מקור בלבד (בפיתוח הכל פתוח ממילא).
CORS_ORIGINS=
