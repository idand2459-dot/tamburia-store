# העתק לקובץ בשם .env ומלא ערכים אמיתיים.
# הקובץ הזה כן נכנס לגיט — placeholders בלבד, אף פעם לא סוד.
# (test/unit-repo-hygiene.js נכשל אם משתנה סודי כאן אינו ריק.)

# ── שרת ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── PostgreSQL ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tamburia
DB_USER=postgres
DB_PASSWORD=
# רישום כל שאילתה ללוג. ברירת מחדל: פעיל מחוץ לייצור, כבוי בייצור.
DB_LOG_QUERIES=

# ── מייל (Gmail app password) ────────────────────────
# false = לא שולח מיילים באמת, רק רושם ללוג. אז MAIL_USER / MAIL_PASS
# אינם נדרשים — כך שכפול חדש עולה בלי חשבון Gmail. true = שניהם חובה.
MAIL_ENABLED=false
MAIL_USER=
MAIL_PASS=
# לאן נשלחת התראת הזמנה חדשה. ריק = ל-MAIL_USER.
MAIL_TO=

# הקישור לניהול שמופיע במייל של הזמנה חדשה.
ADMIN_URL=http://localhost:3000/admin

# ── הזמנות ───────────────────────────────────────────
# דמי משלוח בשקלים. השרת מחשב את הסכום לפיו; הקליינט מציג אותו מתוך
# DELIVERY_FEE ב-client/src/js/hooks/useCart.js, ושניהם חייבים להתאים.
DELIVERY_FEE=20

# ── הגשת הקליינט ─────────────────────────────────────
# false = השרת מגיש API בלבד, בלי אפליקציית ה-React.
SERVE_CLIENT=true
CLIENT_BUILD_DIR=client/build

# ── אימות אדמין ──────────────────────────────────────
# הסיסמה לכניסה ל-/admin. נבדקת בשרת בלבד. בייצור לפחות 12 תווים,
# אחרת השרת מסרב לעלות.
ADMIN_PASSWORD=
# סוד חתימת האסימונים. חובה בייצור (השרת מסרב לעלות בלעדיו). ייצור ערך:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# תוקף ההתחברות בשעות.
SESSION_TTL_HOURS=12
# הגבלת ניסיונות ההתחברות: כמה ניסיונות, בחלון של כמה מילישניות.
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MS=900000

# ── אבטחה ────────────────────────────────────────────
# CSP כבוי כברירת מחדל — ראה את ההערה ב-middleware/securityHeaders.js.
CSP_ENABLED=false
# HSTS נשלח רק כש-NODE_ENV=production. אל תדליק בלי HTTPS אמיתי.
HSTS_ENABLED=true
# מקורות חיצוניים שמותר להם לפנות ל-API, מופרדים בפסיק.
# ריק = מאותו מקור בלבד (בפיתוח הכל פתוח ממילא).
CORS_ORIGINS=

# ── כלים (רשות) ──────────────────────────────────────
# מסד מקומי נפרד ל-npm test ול-npm run a11y. חובה: בלעדיו הם מסרבים לרוץ.
# יוצרים אותו עם createdb ומוסיפים כאן שורה בצורה:
#   postgresql://<משתמש>:<סיסמה>@localhost:5432/<שם המסד>
# הוא חייב להיות מקומי ושונה ממסד הפיתוח (DB_*). נושא סיסמה: רק ב-.env.
TEST_DATABASE_URL=
# הפורט שעליו npm test מרים שרת משלו. ברירת מחדל: 3100.
TEST_PORT=
# הנתיב ל-Chrome של npm run a11y, כשאינו במקום הרגיל.
CHROME_PATH=

# ── ענן (Render / Neon / Cloudinary) ──────────────────
# DATABASE_URL נקבע רק בשירות האירוח (Render), לא בקובץ הסביבה המקומי: כשהוא קיים
# הוא גובר על DB_*, ו-DB_PASSWORD אינו נדרש. מארח שאינו מקומי מפעיל SSL.
# אין צורך (ואסור) להגדיר אותו במחשב שלך: סקריפט שמטרתו הענן משתמש ב-CLOUD_DATABASE_URL.
DATABASE_URL=
# מסד הענן (Neon), לסקריפטים שעובדים עליו: --target cloud. נקרא מכאן בלבד, ורק
# כשהדגל ניתן; בלעדיו הסקריפט מסרב. סוד: לא מקלידים ולא מייצאים בשורת הפקודה
# (PowerShell שומר פקודות שהוקלדו בקובץ היסטוריה), ולא מעבירים כארגומנט.
CLOUD_DATABASE_URL=
# גודל ה-pool. ברירת מחדל 10; בשירות החינמי 5.
DB_POOL_MAX=
# איפה נשמרות התמונות: local (תיקיית uploads/) או cloudinary.
STORAGE_DRIVER=local
# חובה כש-STORAGE_DRIVER=cloudinary, ולסקריפט עם --target cloud. סוד: ב-Render, ובקובץ
# הזה רק לסקריפטים שמטרתם הענן.
CLOUDINARY_URL=
# מצב האתר: open (החנות המלאה), catalog (קטלוג לצפייה בלבד) או closed
# (דף "האתר בבנייה"). ברירת מחדל: open.
SITE_MODE=open
